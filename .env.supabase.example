# Copiar solo estas variables a .env.local. No borrar los PG* locales hasta verificar la migración.
# Obtener la URI en Supabase > Connect > Transaction pooler (para la aplicación).
# Usar contraseña codificada para URL. Nunca añadir prefijo NEXT_PUBLIC_ a esta variable.
SUPABASE_DATABASE_URL=
# Opcional: certificado CA oficial descargado desde Database Settings > SSL Configuration.
SUPABASE_SSL_CA_FILE=
# En hosting puede usarse SUPABASE_SSL_CA con el contenido PEM en vez de un archivo.
# Mantener postgres durante la preparación; cambiar a supabase después de verificar la copia.
INVENTORY_STORAGE=postgres

# Acceso (solo servidor; nunca añadir NEXT_PUBLIC_ a las claves secretas).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Secret key o legacy service_role: permite crear cuentas desde administración.
SUPABASE_SECRET_KEY=
# Generar con crypto.randomBytes(32).toString('hex').
AUTH_RATE_LIMIT_SECRET=
# En producción, origen exacto HTTPS sin barra final.
APP_ORIGIN=http://127.0.0.1:3000
