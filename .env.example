# Conexión local a PostgreSQL. Nunca usar estas variables en código del navegador.
# Copia este archivo a .env.local y completa los datos en tu equipo.
# No compartas .env.local ni la contraseña por el chat.
PGHOST=localhost
PGPORT=5433
PGDATABASE=sistemainventario
PGUSER=postgres
PGPASSWORD=

# Activar después de configurar contraseña y ejecutar npm run db:setup.
INVENTORY_STORAGE=json
